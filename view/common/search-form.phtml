<?php
/**
 * The CDASH search box in the navigation bar.
 *
 * With AdvancedSearch: a keyword search of the whole collection, Places and
 * Documents alike, on the search page that layout.phtml resolves and passes
 * in as $cdashSearchUrl. Results land in the browse pane (the form is boosted
 * like every other in the shell) and their facets in the Filters drawer.
 *
 * Without it ($cdashSearchUrl null): the original search, Places only, whose
 * Place Item value contains the words, sorted by street address -- built from
 * hidden fields against Omeka's own item browse.
 *
 * Its value is the current search's on a full load only: the banner sits
 * outside #content and is not swapped.
 */
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$cdashSearchUrl = $cdashSearchUrl ?? null;
?>
<?php if ($cdashSearchUrl): ?>
<form action="<?php echo $escape($cdashSearchUrl); ?>" id="search-form" method="get" role="search">
    <input id="searchterm" type="search" name="q"
        value="<?php echo $escape((string) $this->params()->fromQuery('q', '')); ?>"
        placeholder="<?php echo $escape($translate('Search CDASH')); ?>"
        aria-label="<?php echo $escape($translate('Search CDASH')); ?>">
    <button class="fa fa-camera-retro" type="submit"><?php echo $translate('CDASHSearch'); ?></button>
</form>
<?php else:
    $searchAction = $this->url('site/resource', ['controller' => 'item', 'action' => 'browse'], true);
?>
<form action="<?php echo $escape($searchAction); ?>" id="search-form">
    <input id="searchterm" type="text" name="property[0][text]"
        value="<?php echo $escape((string) $this->params()->fromQuery('property[0][text]', '')); ?>"
        placeholder="<?php echo $escape($translate('Place Name or Address Contains')); ?>"
        aria-label="<?php echo $escape($translate('Place Name or Address Contains')); ?>">
    <input type="hidden" name="sort_by" value="cdash:streetSort">
    <input type="hidden" name="sort_order" value="asc">
    <?php // resource_template.id of 'CDASH Place'; property.id of cdash:placeItem. ?>
    <input type="hidden" name="resource_template_id[]" value="4">
    <input type="hidden" name="property[0][joiner]" value="and">
    <input type="hidden" name="property[0][property]" value="290">
    <input type="hidden" name="property[0][type]" value="in">
    <button class="fa fa-camera-retro" type="submit"><?php echo $translate('CDASHSearch'); ?></button>
</form>
<?php endif; ?>
