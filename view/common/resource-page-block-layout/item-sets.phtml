<?php
$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

// The item's Survey Area values, as HTML, put in this placeholder by
// view/omeka/site/item/show.phtml -- this partial is given only $itemSets.
// Empty on any page that does not set it.
$surveyAreas = $this->placeholder('cdash-survey-area')->getArrayCopy();
?>
<?php if ($surveyAreas || $itemSets): ?>
<dl class="item-sets">
    <?php if ($surveyAreas): ?>
    <div class="property">
        <dt><?php echo $this->translate('Survey Area:'); ?></dt>
        <?php foreach ($surveyAreas as $surveyArea): ?>
        <dd class="value"><?php echo $surveyArea; ?></dd>
        <?php endforeach; ?>
    </div>
    <?php endif; ?>
    <?php if ($itemSets): ?>
    <div class="property">
        <dt><?php echo $this->translate('Folder:'); ?></dt>
        <?php foreach ($itemSets as $itemSet): ?>
        <dd class="value">
            <a href="<?php echo $this->escapeHtml($itemSet->url()); ?>"><?php echo $itemSet->displayTitle(null, $valueLang); ?></a>
        </dd>
        <?php endforeach; ?>
    </div>
    <?php endif; ?>
</dl>
<?php endif; ?>
