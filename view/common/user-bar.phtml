<?php
/**
 * Copy of Omeka's user bar, shown only to administrators, with its links sent
 * to an admin tab and the two CDASH geo tools added.
 *
 * Who sees it. Omeka's UserBar helper decides from the show_user_bar site
 * setting and whether anyone is logged in, not from the role, and its admin
 * links need only dashboard access, which every role down to researcher has.
 * So the role is checked here: Global and Site Administrators get the bar;
 * everyone else, logged out included, gets no output at all. That last part
 * matters -- layout.phtml emits hx-select-oob="#user-bar" only when this
 * renders something, and htmx warns on every swap if that target is missing.
 *
 * Where its links go. Every link opens in one named tab, omeka_admin, rather
 * than in the browse pane: htmx boosts only links with no target or _self, so
 * the target alone keeps them out of the swap. One named tab rather than a new
 * one per click, so editing a run of items does not pile up tabs, and the
 * public shell -- the map and its markers -- is never torn down to visit
 * admin. GeoSync and GeoAudit keep their own named windows.
 *
 * Why the bar is server-rendered at all: the shell carries
 * hx-select-oob="#user-bar", so htmx replaces this whole bar from each swap
 * response. Omeka's UserBar helper builds the View and Edit links from the
 * route being rendered, which is what keeps them pointing at the item actually
 * on screen -- they went stale otherwise, since the bar sits outside the
 * swapped #content. Anything added to the bar has to come from the server for
 * the same reason.
 */
use Omeka\Permissions\Acl;

if (!$user || !in_array($user->getRole(), [Acl::ROLE_GLOBAL_ADMIN, Acl::ROLE_SITE_ADMIN], true)) {
    return;
}

$translate = $this->plugin('translate');
$hyperlink = $this->plugin('hyperlink');
$urlHelper = $this->plugin('url');
$adminTab = ['target' => 'omeka_admin'];
$this->headLink()->prependStylesheet($this->assetUrl('css/user-bar.css', 'Omeka'));
$this->headLink()->prependStylesheet('//fonts.googleapis.com/css?family=Source+Code+Pro|Lato:400,400italic,700,700italic');
?>
<div id="user-bar">
	<div class="site-links">
    <?php foreach ($links as $link): ?>
	    <span class="admin <?php echo $link['resource'] . ' ' . $link['action']; ?>">
	        <?php echo $hyperlink($link['text'], $link['url'], $adminTab); ?>
	    </span>
    <?php endforeach; ?>
        <?php // CDASH geo tools. These rewrite the database; _require-admin.php
              // guards them, and only administrators reach this far. ?>
	    <span class="admin cdash-tool">
	        <a href="<?php echo $this->escapeHtml($this->assetUrl('php/geosync.php')); ?>" target="geosync">GeoSync</a>
	    </span>
	    <span class="admin cdash-tool">
	        <a href="<?php echo $this->escapeHtml($this->assetUrl('php/geoaudit.php')); ?>" target="geoaudit">GeoAudit</a>
	    </span>
	</div>

	<div class="user-links">
	    <span class="user-id">
	        <?php
	        $url = $urlHelper('admin/id', ['controller' => 'user', 'id' => $user->getId()]);
	        echo sprintf($translate('Signed in as %s'), $hyperlink($user->getName(), $url, $adminTab));
	        ?>
	    </span>
        <?php echo $hyperlink($translate('Logout'), $urlHelper('logout'), $adminTab + ['class' => 'logout']); ?>
	</div>
</div>
