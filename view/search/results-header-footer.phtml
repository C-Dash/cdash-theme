<?php
/**
 * The controls above the CDASH search results. Overrides the module's
 * view/search/results-header-footer.phtml.
 *
 * Kept: the active search filters (each a plain remove link). Dropped: the
 * sort and per-page selects (2026-11-21, by choice: results keep the
 * config's default order and page size), the total (the page header states
 * it), the paginator (it sits under the cards, as on the theme's browse
 * page), the module's own search forms, and the list/grid/map switch (CDASH
 * shows cards, and the map pane is the map).
 *
 * @var \AdvancedSearch\Api\Representation\SearchConfigRepresentation $searchConfig
 * @var \AdvancedSearch\Query $query
 * @var \AdvancedSearch\Response $response
 * @var string $resultPart "header" or "footer"
 */

if (($resultPart ?? 'header') !== 'header') {
    return;
}

$filtersMode = $searchConfig->subSetting('results', 'search_filters_mode', 'link_remove');
$showFiltersFieldLabel = (bool) $searchConfig->subSetting('results', 'search_filters_field_label', true);
?>

<?= $searchConfig->renderSearchFilters($query, ['show_field_label' => $showFiltersFieldLabel, 'mode' => $filtersMode]) ?>
