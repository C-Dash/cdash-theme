/**
 * Not <ul class="resource-list">, which is what stock Omeka renders here.
 *
 * These cards are meant to match the Linked Resources block, and the theme's
 * inherited rules for that class make it unwinnable: `ul.resource-list
 * .resource img` in _desktop.scss (0,2,2) and `#content .resource-link img`
 * (1,1,1) both out-specify anything a class-only rule can say, so the old 72px
 * floated-right thumbnail survives whatever is declared later. Specificity
 * beats source order.
 *
 * So this markup carries theme class names of its own and is simply out of
 * reach of those selectors -- no escalation, no !important. The class names
 * deliberately avoid "resource-link" for the same reason. Other lists that
 * still render as ul.resource-list -- site page preview blocks, the item-set
 * index -- keep the inherited styling untouched.
 *
 * The cards are styled by asset/sass/_resource-list.scss from the shared
 * mixins in _cards.scss, which is what makes them the same grid as the Linked
 * Resources block rather than merely a similar one.
 */
?>
<div class="cdash-card-grid">
<?php
$headingTerm = $this->siteSetting('browse_heading_property_term');
$bodyTerm = $this->siteSetting('browse_body_property_term');
foreach ($items as $item):
    $heading = $headingTerm ? $item->value($headingTerm, ['default' => $translate('[Untitled]'), 'lang' => $valueLang]) : $item->displayTitle(null, $valueLang);
    $body = $bodyTerm ? $item->value($bodyTerm, ['lang' => $valueLang]) : $item->displayDescription(null, $valueLang);
?>
    <?php
    /**
     * The card itself is common/cdash-card.phtml, shared with the Linked
     * Resources block so the markup and the caption rules live in one place.
     *
     * The parent Place's title is resolved here, not in the partial, because
     * it is what this block needs and Linked Resources does not: these cards
     * mix Documents from many Places, so "Exterior View, 3 pp." alone would
     * not say which building. An unlinked Document simply gets no prefix
     * rather than taking the page down.
     */
    $placeValue = $item->value('cdash:placeItem');
    $placeTitle = ($placeValue && 'resource' === $placeValue->type())
        ? $placeValue->valueResource()->displayTitle()
        : '';

    echo $this->partial('common/cdash-card', [
        'resource' => $item,
        'titlePrefix' => $placeTitle,
        'description' => $body,
        'valueLang' => $valueLang,
    ]);
    ?>





<?php endforeach; ?>
</div>
<?php echo ($itemSetShow) ? '</div>' : ''; ?>
<?php $this->trigger('view.browse.after'); ?>
