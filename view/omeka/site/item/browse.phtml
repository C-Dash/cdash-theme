                $marker = "<img src=" . $this->assetUrl('img/sepia_marker_hollow_yello_halo.png') . "/>" ;
            endif;
            echo $item->linkRaw($marker . $item->displayTitle(null, $valueLang), null, ['class' => 'resource-link']); 
        endif; 
