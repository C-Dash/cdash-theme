$query = $this->params()->fromQuery();
$itemSetShow = isset($itemSet);
if ($itemSetShow):
    $this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
    // Tells a folder's contents apart from search results. It reaches CSS as
    // #content[data-cdash-page~="item-set"] -- see layout.phtml.
    $this->htmlElement('body')->appendAttribute('class', 'item-set');
    $query['item_set_id'] = $itemSet->id();
endif;

// The whole result set, not this page of it. Omeka's ItemController hands the
// API's total to the paginator, which is what the pagination nav counts too.
$total = $this->pagination()->getPaginator()->getTotalCount();
$countLabel = $total
    ? sprintf($translate($total === 1 ? '%d item' : '%d items'), $total)
    : $translate('No items');
?>

<?php
// The same sticky header as an item page -- common/cdash-page-header.phtml.
// Title, kind and count only: the Advanced search link, the filter chips and
// the pagination stay in the scrolling content, since every pixel of a sticky
// band is page that can never be scrolled into view.
if ($itemSetShow) {
    echo $this->partial('common/cdash-page-header', [
        'title' => $itemSet->displayTitle(null, $valueLang),
        'kind' => $translate('Folder'),
        'detail' => $countLabel,
    ]);
} else {
    echo $this->partial('common/cdash-page-header', [
        'title' => $translate('Search Results'),
        'detail' => $countLabel,
    ]);
}
?>

