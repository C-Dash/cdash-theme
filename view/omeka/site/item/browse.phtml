         if ($item->value('cdash:placeItem')->type() == 'resource'):



             echo $item->linkRaw($this->thumbnail($item, 'medium') . $item->value('cdash:placeItem')->valueResource()->displayTitle() . " - " . $item->value('dcterms:type'), null, ['class' => 'resource-link']);
