<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$this->headLink()->appendStylesheet($this->assetUrl('css/resource-page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', 'item resource show');
$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

/**
 * Whether this is a Place or a Document -- the distinction the whole site is
 * built around, and one a visitor arriving from a marker or a search result
 * cannot read off the title.
 *
 * Only the terms whose stored label is wrong for CDASH are mapped:
 * bibo:Document already labels itself "Document", while dcterms:Location
 * labels itself "Location", which is not what this site calls it anywhere
 * else. An unclassed item, or a class added later, falls back to its own
 * translated label rather than rendering an empty line.
 */
$resourceClass = $item->resourceClass();
$classLabels = [
    'dcterms:Location' => 'Place', // @translate
];
$isDocument = $resourceClass && 'bibo:Document' === $resourceClass->term();
$classLabel = '';
if ($resourceClass) {
    $classLabel = $classLabels[$resourceClass->term()] ?? $resourceClass->label();
    $classLabel = $translate($classLabel);
}

/**
 * ...and how big it is: pages for a Document, linked Documents for a Place.
 *
 * subjectValueTotalCount() is Omeka's own count of resources pointing AT this
 * one, which is what the Linked Resources block lists below. Site scoping has
 * to match that block exactly or the header can claim documents the list does
 * not show: it passes a site id only when exclude_resources_not_in_site is on
 * (see Omeka's common/resource-page-block-layout/linked-resources.phtml), so
 * this does the same. That matters here -- a site whose item pool is empty
 * renders an empty list, and a header disagreeing with it would send the next
 * person hunting the wrong bug.
 *
 * A count of zero prints nothing rather than "0 documents".
 */
$itemMeta = '';
if ($isDocument) {
    $pages = (int) (string) $item->value('bibo:numPages');
    if ($pages > 0) {
        $itemMeta = sprintf($translate($pages === 1 ? '%d p.' : '%d pp.'), $pages);
    }
} elseif ($resourceClass) {
    $siteId = $this->siteSetting('exclude_resources_not_in_site')
        ? $this->currentSite()->id()
        : null;
    $documents = $item->subjectValueTotalCount(null, 'items', $siteId);
    if ($documents > 0) {
        $itemMeta = sprintf(
            $translate($documents === 1 ? '%d document' : '%d documents'),
            $documents
        );
    }
}

/**
 * The credit and rights statement, shown at the foot of every item page.
 *
 * Fixed text rather than the item's own values, deliberately. Both lines exist
 * in the data as dcterms:bibliographicCitation and dcterms:rights, but only on
 * Documents, and with one distinct value each across all of them -- boilerplate
 * stored per item. Taking it from the theme puts the credit on Place pages too,
 * where there is no stored value to read. Both terms are therefore hidden in
 * view/common/resource-values.phtml, or a Document would show each line twice.
 *
 * This is the one place to edit the wording. If it starts changing often, the
 * next step is a theme setting in config/theme.ini, beside the banner and the
 * accent colour.
 */
$itemFooter = [
    'Citation' => 'Cambridge Historical Commission, Digital Architectural Survey and History.', // @translate
    'Rights' => 'Rights status not evaluated.', // @translate
];
?>
<?php
/**
 * Sticky header: what you are looking at stays visible while the page scrolls.
 *
 * A div, NOT a <header>: print.scss hides the `header` element outright, for
 * the site banner, and would take the item title off paper with it.
 *
 * Breadcrumbs are meant to go above the title later; this wrapper is where
 * they will land.
 */
?>
<div class="cdash-item-header">
    <?php echo $this->pageTitle($item->displayTitle(null, $valueLang), 2); ?>
    <?php if ($classLabel !== ''): ?>
    <p class="cdash-item-meta">
        <?php echo $escape($classLabel); ?>
        <?php if ($itemMeta !== ''): ?>
        <span class="cdash-item-meta-sep" aria-hidden="true">&middot;</span>
        <?php echo $escape($itemMeta); ?>
        <?php endif; ?>
    </p>
    <?php endif; ?>
</div>
<?php $this->trigger('view.show.before'); ?>
<?php echo $this->resourcePageBlocks($item)->getBlocks(); ?>
<?php $this->trigger('view.show.after'); ?>

<?php // Same dl > div.property > dt + dd markup as the property list, on
      // purpose: #content dl and #content .property in _desktop.scss carry the
      // auto-fit columns, the max-content label column and the stack-below-
      // 500px behaviour, so this block inherits all of it and needs no layout
      // rules of its own. ?>
<div class="cdash-item-footer">
    <dl>
        <?php foreach ($itemFooter as $label => $text): ?>
        <div class="property">
            <dt><?php echo $escape($translate($label)); ?><b>:</b></dt>
            <dd class="value">
                <span class="value-content"><?php echo $escape($translate($text)); ?></span>
            </dd>
        </div>
        <?php endforeach; ?>
    </dl>
</div>

<!-- Stock Omeka wraps each page thumbnail in a link to the original TIF. CDASH
     does not want that link, and it is no longer rendered: the theme's copy of
     the block template passes `link => null` to $media->render(), so the
     anchor is absent from the markup. See
     view/common/resource-page-block-layout/media-embeds.phtml.

     This was an inline <script> here, then a JS fixup that stripped the href
     after every browse-pane swap. Both are gone -- the second was only needed
     because the first could not run on a swap, and neither is needed once the
     server stops emitting the anchor. -->