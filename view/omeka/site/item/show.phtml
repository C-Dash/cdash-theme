<!-- The default behavior for the media-embed block is to attach a hyperlink to the image
    that references the original tif file.  This CDASH modification removes that.  
    WIth this mod, the user has access to the right-click menu for saving the thumbnail or
    opening it in a new window. 
    This is also where we might put some code that achieves a zoom function on each image.-->
<script>
images = document.getElementsByClassName("media-render file")
for (let i = 0; i < images.length; i++) {
    anchors = images[i].getElementsByTagName('a')
    for (let j = 0; j < anchors.length; j++) {
         anchors[j].removeAttribute("href");
       }
}
</script>