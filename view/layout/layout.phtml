// Builds Leaflet layers from view/cdash/layer-registry.php. Must load after the
// Leaflet plugins above, since it calls into L.esri and L.GeoJSON.AJAX.
$this->headScript()->appendFile($this->assetUrl('js/cdash-layer-factory.js'));

// The map itself. Deferred so it runs after the document is parsed and the
// #cdash-map-config island it reads exists; deferred scripts also run in source
// order, so the layer factory above is defined by the time this needs it.
$this->headScript()->appendFile($this->assetUrl('js/cdash-map.js'), 'text/javascript', ['defer' => true]);

// Application shell: pane splitter, banner collapse, and the Layers/Filters
// drawers. cdash-layout.js registers Alpine components on the alpine:init
// event, so it must be parsed BEFORE Alpine boots -- hence defer on both,
// which preserves document order, rather than Alpine's usual plain script tag.
// media 'screen', not 'all'. It was 'all' only because this stylesheet used to
// carry its own @media print block, which existed purely to undo the shell's
// grid, 100dvh and overflow:hidden on paper. Those rules have moved to
// print.scss, and keeping the shell off paper entirely means there is nothing
// left to undo -- print.css only has to say which chrome to hide.
$this->headLink()->appendStylesheet($this->assetUrl('css/cdash-shell.css'), 'screen');
$this->headScript()->appendFile($this->assetUrl('js/cdash-layout.js'), 'text/javascript', ['defer' => true]);
$this->headScript()->appendFile($this->assetUrl('vendor/alpine/alpine.min.js'), 'text/javascript', ['defer' => true]);

// htmx swaps the browse pane in place instead of reloading the document, which
// is what lets the map survive navigation. Deferred: it processes hx-* on
// DOMContentLoaded, so it does not need to run before the body parses.
$this->headScript()->appendFile($this->assetUrl('vendor/htmx/htmx.min.js'), 'text/javascript', ['defer' => true]);

// The Filters drawer renders common/advanced-search, which registers these two
// assets itself -- but it does so during body render, by which point the head
// has already been emitted and the registration is silently dropped. Declaring
// them here is what actually gets them onto the page.
$this->headLink()->appendStylesheet($this->assetUrl('css/advanced-search.css', 'Omeka'));
$this->headScript()->appendFile($this->assetUrl('js/advanced-search.js', 'Omeka'));

// End of CDASH includes


$this->jsTranslate();
$banner = $this->themeSettingAssetUrl('banner');
// The banner is a grid track of .cdash-app-shell whose height is the custom
// property --cdash-banner-h, animated to 0% when the banner collapses. These
// settings therefore feed that property rather than a height declaration --
// setting height directly would fight the track and break the animation.
// Empty means "not set": leave the property alone so shell.css's 15% stands.
//
// These land inside a <style> block, where neither escapeHtml (wrong context)
// nor escapeCss (it would escape the "." in 1.5rem and break the value) is
// right. Validate as a CSS length instead: anything that is not one is
// discarded, and shell.css's default stands.
$cssLength = function ($v) {
    $v = trim((string) $v);
    return preg_match('/^\d+(\.\d+)?(px|em|rem|%|vh|vw|dvh|svh|lvh|pt|pc|ch|ex|cm|mm|in|q)$/i', $v)
        ? $v : '';
};
$bannerHeight = $cssLength($this->themeSetting('banner_height'));
$bannerHeightMobile = $cssLength($this->themeSetting('banner_height_mobile'));

// banner_position was align-items on a flex banner. The banner image now fills
// its track with object-fit:cover, so the equivalent is object-position: it
// picks which part of the image survives the crop.
$bannerPosition = [
    'flex_start' => 'top',
    'flex_end'   => 'bottom',
    'center'     => 'center',
][(string) $this->themeSetting('banner_position')] ?? 'center';
$this->trigger('view.layout');
$userBar = $this->userBar();
