<?php
/**
 * The map pane: the element Leaflet draws into, plus everything the map needs
 * from the server.
 *
 * The map logic itself is asset/js/cdash-map.js, loaded from layout.phtml. It
 * lived here as ~460 lines of inline JavaScript until it was extracted; a
 * template is a bad home for a program, because nothing can lint it, browsers
 * cannot cache it, and it is re-sent with every page render.
 *
 * The two are joined by the JSON island below and nothing else. Add a value
 * here when the map needs something only PHP knows; do not reintroduce PHP into
 * the JavaScript.
 *
 * JSON_HEX_TAG and JSON_HEX_AMP escape < > and & to \uXXXX, so no value -- a
 * popup template, a label, an attribution -- can close the enclosing script tag
 * and inject markup. JSON_UNESCAPED_UNICODE keeps non-ASCII readable rather
 * than escaping it twice.
 *
 * Original file header, kept for provenance:
 *   This phtml provides the map and search pane for the CDASH Split Theme.
 *   Paul Cote, paulbcote@gmail.com
 */

$cdashMapConfig = [
    // One entry per layer; also drives the overlay and basemap menus, so the
    // two can never drift apart. See view/cdash/layer-registry.php.
    'layers' => require __DIR__ . '/layer-registry.php',

    // Whichever site is actually rendering. 4.1.1 hardcoded "/s/cdash", so
    // renaming a site silently pointed its markers at a different one.
    'siteUrl' => $this->currentSite()->url(),

    // The marker feed. Queried once per session, not once per click.
    'markersUrl' => $this->assetUrl('php/placemarkers.php'),

    'icons' => [
        'featured'        => $this->assetUrl('img/redcircle.png'),
        'marker'          => $this->assetUrl('img/sepia_marker_hollow2.png'),
        'markerHighlight' => $this->assetUrl('img/sepia_marker_hollow_yello_halo.png'),
    ],
];
?>

<div id="drawmap" style="height: 100%;"></div>

<script type="application/json" id="cdash-map-config">
<?php echo json_encode(
    $cdashMapConfig,
    JSON_HEX_TAG | JSON_HEX_AMP | JSON_UNESCAPED_UNICODE
); ?>
</script>
