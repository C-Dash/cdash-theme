<?php
/**
 * Basemap radios, generated from view/cdash/layer-registry.php.
 * Add a layer there, not here.
 *
 * Generating these fixes two long-standing typos in the 4.1.1 hand-written
 * markup: the cam2021 and cam2018 labels pointed at ids "cam21" and "camPhoto",
 * neither of which exists, so clicking those two labels did nothing.
 */
$escape  = $this->plugin('escapeHtml');
$infodot = $this->assetUrl('img/infodot.png');
$layers  = require __DIR__ . '/../layer-registry.php';
?>

<p><b>Base Maps</b></p>

<?php foreach ($layers as $layer): ?>
    <?php if ($layer['group'] !== 'basemap' || !empty($layer['hidden'])) continue; ?>
  <input type="radio" name="mapchoice" id="<?php echo $escape($layer['key']); ?>">
  <label for="<?php echo $escape($layer['key']); ?>"><?php echo $escape($layer['label']); ?></label>
    <?php if (!empty($layer['source'])): ?>
  <div class="tooltip"><img src="<?php echo $escape($infodot); ?>" alt="">
    <span class="tooltiptext">
        <?php if (!empty($layer['sourceUrl'])): ?>
      Shared by <a href="<?php echo $escape($layer['sourceUrl']); ?>" target="Cdash_Link"><?php echo $escape($layer['source']); ?></a>
        <?php else: ?>
        <?php echo $escape($layer['source']); ?>
        <?php endif; ?>
    </span></div>
    <?php endif; ?>
  <br>
<?php endforeach; ?>
