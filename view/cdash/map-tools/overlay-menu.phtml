<?php
/**
 * Overlay checkboxes, generated from view/cdash/layer-registry.php.
 * Add a layer there, not here.
 */
$escape  = $this->plugin('escapeHtml');
$infodot = $this->assetUrl('img/infodot.png');
$layers  = require __DIR__ . '/../layer-registry.php';
?>

<p><b>Map Overlays</b> <br>
  <span class="cdash-layer-hint">Click features on map for more information.</span></p>

<?php foreach ($layers as $layer): ?>
    <?php if ($layer['group'] !== 'overlay' || !empty($layer['hidden'])) continue; ?>
  <input type="checkbox" id="<?php echo $escape($layer['key']); ?>">
  <label for="<?php echo $escape($layer['key']); ?>"><?php echo $escape($layer['label']); ?></label>
    <?php if (!empty($layer['source'])): ?>
  <div class="tooltip"><img src="<?php echo $escape($infodot); ?>" alt="">
    <span class="tooltiptext">
        <?php if (!empty($layer['sourceUrl'])): ?>
      Shared by <a href="<?php echo $escape($layer['sourceUrl']); ?>" target="Cdash_Link"><?php echo $escape($layer['source']); ?></a>
        <?php else: ?>
        <?php echo $escape($layer['source']); ?>
        <?php endif; ?>
    </span></div>
    <?php endif; ?>
  <br>
<?php endforeach; ?>
